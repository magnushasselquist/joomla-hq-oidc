{
    "name": "magnushasselquist/plg-system-hqoidc",
    "description": "Minimal Joomla 5/6 OIDC SSO plugin (Keycloak-tested). Auth code + PKCE, match-only or auto-create users, RP-initiated single logout.",
    "type": "joomla-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Plugin\\System\\HqOidc\\": "src/",
            "Joomla\\Plugin\\System\\HqOidc\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
